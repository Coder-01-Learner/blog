```c

printf("abcd");

printf("abcd\\0");

printf("abcd\\0efg");

printf("%s","abcd");

printf("%s","abcd\\0");

printf("%s","abcd\\0efg");

//这6行代码的效果是一样的

```



















































```c

printf("%c",'Q');

printf("%c",'\\x51');

printf("%c",'\\121');

printf("%c",81);

//这些都表示字符Q

```















